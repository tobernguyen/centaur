# No secrets: iron-proxy injects credentials on the wire (or the server needs
# none). For local development only: in sandboxes CENTAUR_MCP_SERVERS comes
# from the deployment's sandbox env. TOML, one [servers.<name>] stanza each:
# CENTAUR_MCP_SERVERS=[servers.clickhouse]
# url = "https://mcp-gateway.internal.example/mcp/clickhouse"
# note = "main data warehouse"
